# =====================================================================
# Quant Execution Engine - Environment Variables Configuration
# Copy this file to .env and provide your validated production credentials
# =====================================================================

# AWS Cloud Infrastructure (VPS & SSM Automation)
AWS_ACCESS_KEY_ID=AKIA_YOUR_ACTUAL_AWS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_ACTUAL_AWS_SECRET_KEY_HERE
AWS_DEFAULT_REGION=ap-southeast-1

# MetaTrader 5 Terminal Credentials
MT5_LOGIN=12345678
MT5_PASSWORD=YourSecureMT5Password!
MT5_SERVER=YourBroker-DemoOrLiveServer
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Telegram Risk Guardian & Telemetry
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_ALERT_THRESHOLD_USD=500.0

# Execution & Risk Parameters
MAX_DAILY_DRAWDOWN_PERCENT=2.5
MAX_POSITION_SIZE_LOTS=5.0
SLIPPAGE_TOLERANCE_PIPS=1.5
ORDER_ROUTING_TIMEOUT_MS=250
